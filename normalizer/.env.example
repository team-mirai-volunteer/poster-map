# Google Maps Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# API エンドポイント設定（セキュリティ強化）
# デフォルトでJageocoderエンドポイントは無効化されています
# 本番・テスト共通でこの環境変数を使用します
# 使用する場合は以下のコメントアウトを外してください
# JAGEOCODER_ENDPOINT=https://your-jageocoder-server.example.com
#
# 注意：JAGEOCODER_ENDPOINTはベースURLのみを指定してください
# システムが自動的に '/geocode' と '/rgeocode' パスを付加します

# カスタムエンドポイント（オプション）
# GOOGLE_GEOCODING_ENDPOINT=https://maps.googleapis.com/maps/api/geocode/json
# GSI_GEOCODING_ENDPOINT=https://msearch.gsi.go.jp/address-search/AddressSearch

# API設定のカスタマイズ（オプション）
# API_TIMEOUT=10
# DEFAULT_DISTANCE_THRESHOLD=200
# DEFAULT_SLEEP_MSEC=200
# DEFAULT_REVERSE_GEOCODE_LEVEL=7

# Google Cloud Run デプロイメント設定
# PROJECT_ID=your-gcp-project-id
# SA_NORMALIZER=your-service-account-email
